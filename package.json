{
	"name": "jamot-lite",
	"version": "0.0.0",
	"private": true,
	"description": "Jamot Lite \u2014 the company runtime. One company, one process, one folder.",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": ">=22.19"
	},
	"scripts": {
		"typecheck": "pnpm -r typecheck",
		"test": "vitest run",
		"lint": "biome ci .",
		"format": "biome format --write .",
		"jamot": "tsx apps/runtime/src/cli.ts",
		"build": "pnpm --filter @jamot/web build && node scripts/build.mjs",
		"ledger": "node scripts/ledger.mjs",
		"smoke": "node scripts/smoke-bundle.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^22.20.4",
		"esbuild": "0.28.2",
		"tsx": "^4.23.15",
		"typescript": "5.9.3",
		"vitest": "^5.0.2"
	}
}
